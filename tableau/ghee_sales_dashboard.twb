          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.salesman].[none:salesman_name:nk]</rows>
        <cols>[federated.salesman].[avg:litres_per_account:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Sales Review'>
      <style />
      <size maxheight='900' maxwidth='1200' minheight='900' minwidth='1200' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontsize='16'>Madhusudan Ghee - Sales Review, FY2022-23 to FY2024-25</run>
              <run fontsize='11'>&#10;Revenue is up 8.3%. Volume is up 2.9%. The difference is price, and established customers are buying 8.9% less.</run>
            </formatted-text>
          </zone>
          <zone h='30000' id='3' name='Revenue by Year' w='50000' x='0' y='8000' />
          <zone h='30000' id='4' name='Volume by Year' w='50000' x='50000' y='8000' />
          <zone h='31000' id='5' name='Price per Litre' w='50000' x='0' y='38000' />
          <zone h='31000' id='6' name='Volume per Account' w='50000' x='50000' y='38000' />
          <zone h='31000' id='7' name='Seasonality' w='50000' x='0' y='69000' />
          <zone h='31000' id='8' name='Salesman Productivity' w='50000' x='50000' y='69000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
