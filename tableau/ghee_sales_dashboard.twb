<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2023.1.0 (20231.23.0310.1045)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Ghee Sales' inline='true' name='federated.ghee' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='ghee_sales_extract' name='textscan.ghee'>
            <connection class='textscan' directory='.' filename='ghee_sales_extract.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.ghee' name='ghee_sales_extract.csv' table='[ghee_sales_extract#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='date' name='invoice_date' ordinal='0' />
            <column datatype='string' name='invoice_no' ordinal='1' />
            <column datatype='string' name='fy' ordinal='2' />
            <column datatype='integer' name='month_no' ordinal='3' />
            <column datatype='string' name='account_code' ordinal='4' />
            <column datatype='string' name='account_name' ordinal='5' />
            <column datatype='string' name='city' ordinal='6' />
            <column datatype='string' name='salesman_code' ordinal='7' />
            <column datatype='string' name='salesman_name' ordinal='8' />
            <column datatype='string' name='sku' ordinal='9' />
            <column datatype='string' name='product_name' ordinal='10' />
            <column datatype='string' name='pack_size' ordinal='11' />
            <column datatype='integer' name='cartons' ordinal='12' />
            <column datatype='real' name='litres' ordinal='13' />
            <column datatype='real' name='rate_per_carton' ordinal='14' />
            <column datatype='real' name='sales_amount' ordinal='15' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Invoice Date' datatype='date' name='[invoice_date]' role='dimension' type='ordinal' />
      <column caption='Invoice No' datatype='string' name='[invoice_no]' role='dimension' type='nominal' />
      <column caption='Financial Year' datatype='string' name='[fy]' role='dimension' type='nominal' />
      <column caption='Month' datatype='integer' name='[month_no]' role='dimension' type='ordinal' />
      <column caption='Account Code' datatype='string' name='[account_code]' role='dimension' type='nominal' />
      <column caption='Account' datatype='string' name='[account_name]' role='dimension' type='nominal' />
      <column caption='City' datatype='string' name='[city]' role='dimension' type='nominal' />
      <column caption='Salesman Code' datatype='string' name='[salesman_code]' role='dimension' type='nominal' />
      <column caption='Salesman' datatype='string' name='[salesman_name]' role='dimension' type='nominal' />
      <column caption='SKU' datatype='string' name='[sku]' role='dimension' type='nominal' />
      <column caption='Product' datatype='string' name='[product_name]' role='dimension' type='nominal' />
      <column caption='Pack Size' datatype='string' name='[pack_size]' role='dimension' type='nominal' />
      <column caption='Cartons' datatype='integer' name='[cartons]' role='measure' type='quantitative' />
      <column caption='Litres' datatype='real' name='[litres]' role='measure' type='quantitative' />
      <column caption='Rate per Carton' datatype='real' name='[rate_per_carton]' role='measure' type='quantitative' />
      <column caption='Revenue' datatype='real' name='[sales_amount]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Revenue by Year'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>Revenue rose 8.3% across the three years</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Ghee Sales' name='federated.ghee' />
          </datasources>
          <datasource-dependencies datasource='federated.ghee'>
            <column caption='Financial Year' datatype='string' name='[fy]' role='dimension' type='nominal' />
            <column-instance column='[fy]' derivation='None' name='[none:fy:nk]' pivot='key' type='nominal' />
            <column caption='Revenue' datatype='real' name='[sales_amount]' role='measure' type='quantitative' />
            <column-instance column='[sales_amount]' derivation='Sum' name='[sum:sales_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.ghee].[sum:sales_amount:qk]</rows>
        <cols>[federated.ghee].[none:fy:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Volume by Year'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>Volume rose only 2.9%, and fell in the last year</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Ghee Sales' name='federated.ghee' />
          </datasources>
          <datasource-dependencies datasource='federated.ghee'>
            <column caption='Financial Year' datatype='string' name='[fy]' role='dimension' type='nominal' />
            <column-instance column='[fy]' derivation='None' name='[none:fy:nk]' pivot='key' type='nominal' />
            <column caption='Litres' datatype='real' name='[litres]' role='measure' type='quantitative' />
            <column-instance column='[litres]' derivation='Sum' name='[sum:litres:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.ghee].[sum:litres:qk]</rows>
        <cols>[federated.ghee].[none:fy:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Seasonality'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>October is 1.7x July</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Ghee Sales' name='federated.ghee' />
          </datasources>
          <datasource-dependencies datasource='federated.ghee'>
            <column caption='Month' datatype='integer' name='[month_no]' role='dimension' type='ordinal' />
            <column-instance column='[month_no]' derivation='None' name='[none:month_no:ok]' pivot='key' type='ordinal' />
            <column caption='Litres' datatype='real' name='[litres]' role='measure' type='quantitative' />
            <column-instance column='[litres]' derivation='Sum' name='[sum:litres:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.ghee].[sum:litres:qk]</rows>
        <cols>[federated.ghee].[none:month_no:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='Revenue by City'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>Kairana carries 19% of revenue</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Ghee Sales' name='federated.ghee' />
          </datasources>
          <datasource-dependencies datasource='federated.ghee'>
            <column caption='City' datatype='string' name='[city]' role='dimension' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column caption='Revenue' datatype='real' name='[sales_amount]' role='measure' type='quantitative' />
            <column-instance column='[sales_amount]' derivation='Sum' name='[sum:sales_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.ghee].[none:city:nk]</rows>
        <cols>[federated.ghee].[sum:sales_amount:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Sales Review'>
      <style />
      <size maxheight='900' maxwidth='1200' minheight='900' minwidth='1200' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontsize='16'>Madhusudan Ghee - Sales Review, FY2022-23 to FY2024-25</run>
              <run fontsize='11'>&#10;Revenue is up 8.3%. Volume is up 2.9%. The difference is price, and established customers are buying 8.9% less.</run>
            </formatted-text>
          </zone>
          <zone h='46000' id='3' name='Revenue by Year' w='50000' x='0' y='8000' />
          <zone h='46000' id='4' name='Volume by Year' w='50000' x='50000' y='8000' />
          <zone h='46000' id='5' name='Seasonality' w='50000' x='0' y='54000' />
          <zone h='46000' id='6' name='Revenue by City' w='50000' x='50000' y='54000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height='30'>
    <window class='worksheet' name='Revenue by Year'>
      <cards>
        <edge name='left'><strip size='160'>
          <card type='pages' /><card type='filters' /><card type='marks' />
        </strip></edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='Volume by Year'>
      <cards>
        <edge name='left'><strip size='160'>
          <card type='pages' /><card type='filters' /><card type='marks' />
        </strip></edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='Seasonality'>
      <cards>
        <edge name='left'><strip size='160'>
          <card type='pages' /><card type='filters' /><card type='marks' />
        </strip></edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='Revenue by City'>
      <cards>
        <edge name='left'><strip size='160'>
          <card type='pages' /><card type='filters' /><card type='marks' />
        </strip></edge>
        <edge name='top'>
          <strip size='2147483647'><card type='columns' /></strip>
          <strip size='2147483647'><card type='rows' /></strip>
        </edge>
      </cards>
    </window>
    <window class='dashboard' name='Sales Review'>
      <viewpoints />
      <active id='-1' />
    </window>
  </windows>
</workbook>
