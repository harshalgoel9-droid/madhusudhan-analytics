      <aliases enabled='yes' />
      <column caption='Realised_rate_per_litre' datatype='real' name='[Calculation_2106988363534336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sales_amount])/sum([litres]))' />
      </column>
      <column caption='Litres per account' datatype='real' name='[Calculation_2106988390490115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([litres]) / COUNTD([account_code]), 1)' />
      </column>
      <column caption='x*times the lowest month' datatype='real' name='[Calculation_2106988721864708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([litres])/WINDOW_MIN(SUM([litres]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Accounts' datatype='integer' name='[Calculation_2106988999000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([account_code])' />
      </column>
