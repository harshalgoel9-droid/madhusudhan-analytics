  <worksheets>
    <worksheet name='Revenue by Year'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>Revenue rose 8.3% across the three years</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Ghee Sales' name='federated.ghee' />
          </datasources>
          <datasource-dependencies datasource='federated.ghee'>
            <column datatype='string' name='[fy]' role='dimension' type='nominal' />
            <column-instance column='[fy]' derivation='None' name='[none:fy:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[sales_amount]' role='measure' type='quantitative' />
            <column-instance column='[sales_amount]' derivation='Sum' name='[sum:sales_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.ghee].[sum:sales_amount:qk]</rows>
        <cols>[federated.ghee].[none:fy:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Volume by Year'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>Volume rose only 2.9%, and fell in the last year</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Ghee Sales' name='federated.ghee' />
          </datasources>
          <datasource-dependencies datasource='federated.ghee'>
            <column datatype='string' name='[fy]' role='dimension' type='nominal' />
            <column-instance column='[fy]' derivation='None' name='[none:fy:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[litres]' role='measure' type='quantitative' />
            <column-instance column='[litres]' derivation='Sum' name='[sum:litres:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.ghee].[sum:litres:qk]</rows>
        <cols>[federated.ghee].[none:fy:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Price per Litre'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>Price per litre rose 5.3%, which is where the growth came from</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='By Year' name='federated.year' />
          </datasources>
          <datasource-dependencies datasource='federated.year'>
            <column datatype='string' name='[fy]' role='dimension' type='nominal' />
            <column-instance column='[fy]' derivation='None' name='[none:fy:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[rate_per_litre]' role='measure' type='quantitative' />
            <column-instance column='[rate_per_litre]' derivation='Avg' name='[avg:rate_per_litre:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.year].[avg:rate_per_litre:qk]</rows>
        <cols>[federated.year].[none:fy:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Volume per Account'>
      <layout-options>
        <title>
          <formatted-text><run fontsize='11' bold='true'>Accounts up 18%, litres per account down 13%</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='By Year' name='federated.year' />
          </datasources>
          <datasource-dependencies datasource='federated.year'>
            <column datatype='string' name='[fy]' role='dimension' type='nominal' />
            <column-instance column='[fy]' derivation='None' name='[none:fy:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[litres_per_account]' role='measure' type='quantitative' />
